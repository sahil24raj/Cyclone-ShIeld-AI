# ==============================================================================
# CYCLONE SHIELD AI / CYCLONE-X - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and configure your external data source endpoints.
# DO NOT COMMIT REAL SECRETS OR PRIVATE API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IMD (INDIA METEOROLOGICAL DEPARTMENT) OFFICIAL API GATEWAY
# ------------------------------------------------------------------------------
# Endpoints integrated:
# - Current Weather: https://api.imd.gov.in/api/v1/current_wx
# - City Forecast: https://api.imd.gov.in/api/v1/cityforecast?id=42182
# - District Nowcast: https://api.imd.gov.in/api/v1/districtnowcast
# - District Rainfall: https://api.imd.gov.in/api/v1/districtrainfall
# - Subdivision Rainfall Forecast: https://api.imd.gov.in/api/v1/subdivision_rainfall_forecast
# - City Forecast Mapping: https://api.imd.gov.in/api/v1/cityforecast_mapping
#
# IMD API Key (Passed via 'x-api-key' header)
VITE_IMD_API_KEY=
# IMD Bearer Token / JWT (Passed via 'Authorization: Bearer <TOKEN>' header)
VITE_IMD_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. GLOBAL WMO / OPEN-METEO NUMERICAL WEATHER (FALLBACK / OPEN-ACCESS)
# ------------------------------------------------------------------------------
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
VITE_WEATHER_API_KEY=

# ------------------------------------------------------------------------------
# 3. CYCLONE OBSERVATION & OFFICIAL FORECAST FEEDS (IMD / JTWC / IBTrACS)
# ------------------------------------------------------------------------------
# Authoritative cyclone bulletined track and forecast JSON/GeoJSON feed URL
VITE_CYCLONE_FEED_URL=

# ------------------------------------------------------------------------------
# 4. ML PREDICTION SERVICE (Trained Neural Net / GBDT Model Backend)
# ------------------------------------------------------------------------------
# Dedicated microservice endpoint for Cyclone Intensity & Track ML predictions
VITE_ML_SERVICE_URL=

# ------------------------------------------------------------------------------
# 5. GEOSPATIAL & INFRASTRUCTURE DATASETS (GeoJSON / Spatial API)
# ------------------------------------------------------------------------------
# Custom GeoJSON endpoint for critical infrastructure assets
VITE_INFRASTRUCTURE_GEOJSON_URL=
# Custom GeoJSON endpoint for administrative boundary & ward/village risk features
VITE_VILLAGES_GEOJSON_URL=

# ------------------------------------------------------------------------------
# 6. HISTORICAL CYCLONE DATABASE (IBTrACS / IMD Archives)
# ------------------------------------------------------------------------------
VITE_HISTORICAL_API_URL=

# ------------------------------------------------------------------------------
# 7. BASEMAP TILES (Optional Mapbox / CARTO API Keys)
# ------------------------------------------------------------------------------
VITE_CARTO_API_KEY=
VITE_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 8. DEVELOPMENT FIXTURES (STRICTLY FOR ISOLATED LOCAL TESTING)
# ------------------------------------------------------------------------------
# Set to 'true' ONLY in local sandbox testing to inspect component layouts.
# When 'false' or omitted, the application strictly uses live sources or shows empty/unavailable states.
VITE_ENABLE_DEV_FIXTURES=false
